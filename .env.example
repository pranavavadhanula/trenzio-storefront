# ---------------------------------------------------------------------------
# TREVORI environment variables
# Copy the values you need into your local .env (never commit real secrets).
# ---------------------------------------------------------------------------

# Shopify catalog (Storefront API — safe to expose in the browser)
VITE_SHOPIFY_STORE_DOMAIN=
VITE_SHOPIFY_STOREFRONT_TOKEN=

# Razorpay direct checkout (server-side only)
# Use the Razorpay Dashboard → Settings → API Keys values.
# SECRET MUST NEVER be exposed to the browser or prefixed with VITE_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: used only if you add Razorpay webhook handling.
RAZORPAY_WEBHOOK_SECRET=

# Printrove custom store integration (server-side only)
# Get from Printrove Dashboard -> Connect your Custom Store
PRINTROVE_API_TOKEN=
PRINTROVE_REFRESH_TOKEN=
PRINTROVE_MERCHANT_ID=
